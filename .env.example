# Copy to .env and fill in. Never commit .env.
# --- blockchain indexer keys ---
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
SOLSCAN_API_KEY=
COVALENT_API_KEY=
# Blockchair free tier needs no key (verified in M2)

# --- infra (docker-compose defaults match these) ---
POSTGRES_DSN=postgresql+asyncpg://vasp:vasp@postgres:5432/vasp
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vasp-dev-password
REDIS_URL=redis://redis:6379/0

# --- mock SAHYOG ---
SAHYOG_MOCK_URL=http://localhost:8091
ENGINE_WEBHOOK_SECRET=dev-webhook-secret-change-me

# --- engine behaviour (all have dev defaults; set to override) ---
STORE_BACKEND=auto        # auto | postgres | memory
QUEUE_BACKEND=auto        # auto | redis | memory
SANCTIONS_TABLE_PATH=     # full OFAC XML path; empty = fixture sample
WATCH_POLL_MINUTES=15     # watchlist poller cadence
AUTH_ENFORCED=false       # true = require X-API-Key on protected routes

# --- integration-test gates (scripts/smoke_m7_integration.py,
# scripts/smoke_m8_integration.py run only when these are 1) ---
M7_INTEGRATION=0
M8_INTEGRATION=0
